# 微信数据同步配置模板
#
# 用法：复制为 .env 后填一个 token 即可。.env 已被 .gitignore 排除，不会提交。
#     copy .env.example .env
#
# 真实环境变量优先于 .env，便于临时覆盖。

# ---- 必填：一个 token 就够 ------------------------------------------------

# 同步服务的凭据。归档接口（消息/联系人/会话）和图片图库都在同一个服务上、
# 共用同一个凭据，所以只填这一个就行，图库会自动复用它。
WECHAT_SYNC_TOKEN=

# 只有「图库凭据」和「同步凭据」不是同一个时才需要单独填，否则留空。
#AIZEE_TOKEN=

# ---- 服务地址（已有默认值，换服务时才需要改）-----------------------------

# 默认 https://primeapi.aizee.cc/api/wechat
#WECHAT_SYNC_BASE=https://primeapi.aizee.cc/api/wechat

# 图库与归档同主机，默认 https://primeapi.aizee.cc
#AIZEE_GALLERY_BASE=https://primeapi.aizee.cc

# ---- 同步节奏 ------------------------------------------------------------

# 四类实体（联系人/群/群成员/会话）的重跑间隔，秒。默认 24 小时。
ENTITY_INTERVAL_SEC=86400

# 全量兜底间隔，秒。默认 7 天。
#
# 不要关掉：微信换设备登录、漫游同步时会补写 sort_seq 低于当前水位线的历史消息，
# 按水位线收窄的增量扫描看不见它们。兜底那轮绝大部分是幂等 skipped，只补真正缺的。
SWEEP_INTERVAL_SEC=604800

# 抓图片 AES 密钥时等待「用户点开一张图」的秒数，默认 120。
# 定时任务里建议置 0，否则每轮都会白等两分钟；要抓密钥时用默认值手动跑一次 media。
#IMAGE_KEY_WAIT_SEC=0

# ---- 兼容开关（只有换服务时才动）-----------------------------------------

# 鉴权方式。prime 这套默认 direct：token 直接当 Bearer 用。
# 只有老的 aizee-crm 网关需要 exchange（先把 api token 换成短期 JWT）。
#WECHAT_SYNC_AUTH=exchange

# 健康探针路径。默认 /watermark/__health__，用归档接口自身探活
# （一次请求同时验证：服务可达 + token 有效 + 归档模块已加载 + 数据库通）。
#WECHAT_SYNC_HEALTH_PATH=/actuator/health

# 服务端 wechat_messages 有 sender_username 列时才置 1（发了多余的字段会整批 400）。
# prime 的归档表没有这一列，所以默认 0。
#SEND_SENDER_USERNAME=1

# 一台机器要同时保留多份配置（生产/联调）时，用这个变量切换读哪个文件。
#WECHAT_SYNC_ENV_FILE=.env.prime-contact

# ---- 批次大小（一般不用改）----------------------------------------------

# 单批条数，服务端上限 1000。
SYNC_BATCH=500

# 单请求体字节上限，服务端上限 32MiB（33554432）。
SYNC_MAX_BODY=25165824

# 单次 PUT 水位线的 chat 数，服务端上限 1000。
SYNC_WM_BATCH=500
