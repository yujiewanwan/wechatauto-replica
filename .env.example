# 微信数据同步配置模板
#
# 用法：复制为 .env 后按本机情况改。.env 已被 .gitignore 排除，不会提交。
#     cp .env.example .env
#
# 真实环境变量优先于 .env，便于临时覆盖：
#     AIZEE_TOKEN=xxx py sync_to_server.py incremental

# ---- 必填 ----------------------------------------------------------------

# aizee 图库的 api token。缺失时消息和联系人照常同步，只跳过图片上传。
AIZEE_TOKEN=

# ---- 服务地址 ------------------------------------------------------------

# 微信同步服务。默认本机 9005；服务在别的机器上就改这里。
WECHAT_SYNC_BASE=http://127.0.0.1:9005

# 图库服务。
AIZEE_GALLERY_BASE=https://primeapi.aizee.cc

# ---- 同步节奏 ------------------------------------------------------------

# 四类实体（联系人/群/群成员/会话）的重跑间隔，秒。默认 24 小时。
ENTITY_INTERVAL_SEC=86400

# 全量兜底间隔，秒。默认 7 天。
#
# 不要关掉：微信换设备登录、漫游同步时会补写 sort_seq 低于当前水位线的历史消息，
# 按水位线收窄的增量扫描看不见它们。兜底那轮绝大部分是幂等 skipped，只补真正缺的。
SWEEP_INTERVAL_SEC=604800

# ---- 批次大小（一般不用改）----------------------------------------------

# 单批条数，服务端上限 1000。
SYNC_BATCH=500

# 单请求体字节上限，服务端上限 32MiB（33554432）。
SYNC_MAX_BODY=25165824

# 单次 PUT 水位线的 chat 数，服务端上限 1000。
SYNC_WM_BATCH=500

# ---- 兼容开关 ------------------------------------------------------------

# 服务端 wechat_messages 还没有 sender_username 列时置 0，否则整批 400 unknown field。
SEND_SENDER_USERNAME=1
